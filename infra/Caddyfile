# Global options. {client_ip} is the TCP peer, except when the peer is a
# Cloudflare edge (orange-cloud records): then it is CF-Connecting-IP, which
# Cloudflare sets itself. Source: https://www.cloudflare.com/ips/ (2026-11).
# Refresh this list if Cloudflare publishes new ranges.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "{$ROBOTS_TAG}"
		-Server
	}
	log {
		output stdout
		format json
	}
}

# Main domain: public "coming soon" page until launch.
{$APEX_DOMAIN} {
	import common
	root * /srv/coming-soon
	try_files {path} /index.html
	file_server
}

www.{$APEX_DOMAIN} {
	redir https://{$APEX_DOMAIN}{uri} permanent
}

# Buyer website.
{$WEB_DOMAIN} {
	import common
	reverse_proxy web:3000
}

# Staff portal: its own host keeps staff cookies separate from buyers.
{$STAFF_DOMAIN} {
	import common
	header X-Frame-Options "DENY"
	reverse_proxy admin:3001
}

# API, with Socket.IO traffic routed to the realtime gateway.
{$API_DOMAIN} {
	import common
	@socket path /socket.io/*
	# Per-IP rate limits read X-Client-IP. Always overwrite it, so a visitor's
	# own value never reaches the API or the realtime gateway.
	reverse_proxy @socket realtime:4001 {
		header_up X-Client-IP {client_ip}
	}
	reverse_proxy api:4000 {
		header_up X-Client-IP {client_ip}
	}
}
