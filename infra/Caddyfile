# Global options. {client_ip} is the TCP peer, except when the peer is a
# Cloudflare edge (orange-cloud records): then it is CF-Connecting-IP, which
# Cloudflare sets itself. Source: https://www.cloudflare.com/ips/ (2026-11).
# Refresh this list if Cloudflare publishes new ranges.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "{$ROBOTS_TAG}"
		-Server
	}
	log {
		output stdout
		format json
	}
}

# Main domain: public "coming soon" page until launch.
{$APEX_DOMAIN} {
	import common
	root * /srv/coming-soon
	try_files {path} /index.html
	file_server
}

www.{$APEX_DOMAIN} {
	redir https://{$APEX_DOMAIN}{uri} permanent
}

# While an app restarts during a deploy, hold requests and retry instead of
# failing straight away (2026-11-21): a click waits a few seconds and then
# opens normally. Only connection failures are retried, so a request is
# never sent to an app twice.
(wait_for_restart) {
	lb_try_duration 30s
	lb_try_interval 250ms
}

# Buyer website.
{$WEB_DOMAIN} {
	import common
	reverse_proxy web:3000 {
		import wait_for_restart
	}
}

# Staff portal: its own host keeps staff cookies separate from buyers.
{$STAFF_DOMAIN} {
	import common
	header X-Frame-Options "DENY"
	reverse_proxy admin:3001 {
		import wait_for_restart
	}
}

(api) {
	import common
	@socket path /socket.io/*
	# Per-IP rate limits read X-Client-IP. Always overwrite it, so a visitor's
	# own value never reaches the API or the realtime gateway.
	reverse_proxy @socket realtime:4001 {
		header_up X-Client-IP {client_ip}
		import wait_for_restart
	}
	reverse_proxy api:4000 {
		header_up X-Client-IP {client_ip}
		import wait_for_restart
	}
}

# API, with Socket.IO traffic routed to the realtime gateway.
{$API_DOMAIN} {
	import api
}

# Old domain (LotVanta, renamed GiddyDeal on 2026-11-20). Pages move
# permanently to the same address on the new hosts, so links, bookmarks and
# search rankings carry over. The old API host keeps answering, because
# payment webhooks and installed app builds may still call it.
# LEGACY_DOMAIN defaults to legacy.localhost, which only gets a local
# certificate and is never requested from a public certificate authority.
{$LEGACY_DOMAIN}, www.{$LEGACY_DOMAIN} {
	redir https://{$APEX_DOMAIN}{uri} permanent
}

beta.{$LEGACY_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}

staff.{$LEGACY_DOMAIN} {
	redir https://{$STAFF_DOMAIN}{uri} permanent
}

api.{$LEGACY_DOMAIN} {
	import api
}
