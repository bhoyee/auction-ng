# Production/staging settings for docker-compose.prod.yml.
# Lives on the server at /opt/lotvanta/.env.production (chmod 600, never committed).
# infra/deploy/bootstrap.sh creates it with fresh random secrets.
# KEEP AN OFFLINE COPY in a password manager: losing DATA_ENCRYPTION_KEY or
# PII_HASH_KEY makes encrypted personal data in the database unreadable.

# --- Hosts (DNS A records must point at the server) ---
APEX_DOMAIN=lotvanta.ng            # "coming soon" page (www redirects here)
WEB_DOMAIN=beta.lotvanta.ng        # buyer website
STAFF_DOMAIN=staff.lotvanta.ng     # staff portal
API_DOMAIN=api.lotvanta.ng         # API + realtime (/socket.io)
ROBOTS_TAG=noindex, nofollow       # staging: keep out of search engines
DEPLOYMENT_ENV=staging

# --- Database ---
POSTGRES_USER=lotvanta
POSTGRES_PASSWORD=                 # random, 32+ chars
POSTGRES_DB=lotvanta

# --- Secrets (random; generate with: openssl rand -base64 32 / -hex 32) ---
DATA_ENCRYPTION_KEY=               # base64 32 bytes
PII_HASH_KEY=                      # base64 32 bytes
RECONCILIATION_TOKEN=              # hex 32 bytes
SEARCH_SYNC_TOKEN=
BID_MAINTENANCE_TOKEN=
SUPPORT_DELIVERY_TOKEN=
MEILI_MASTER_KEY=

# --- Features ---
BIDS_ENABLED=true                  # staging uses Paystack test mode only
WITHDRAWALS_ENABLED=false

# --- Payments (TEST keys only until a human sets live keys) ---
PAYSTACK_SECRET_KEY=sk_test_...

# --- Email (sign-in codes and notices) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=TLS
SMTP_AUTH=true
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=LotVanta

# --- Contact details shown on the website ---
SUPPORT_EMAIL=
SUPPORT_WHATSAPP_NUMBER=

# --- Images (Cloudflare R2), optional until uploads are needed ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOAD_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=

# --- Off-site backups (Cloudflare R2, private bucket) ---
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
