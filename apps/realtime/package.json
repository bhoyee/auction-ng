{
  "name": "realtime",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "socket.io": "4.8.4",
    "@socket.io/redis-adapter": "8.3.0",
    "redis": "5.8.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
