{
  "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>Your auction result — Auction NG</title><style>@media only screen and (max-width:600px){.outer{padding:24px 16px!important}.content{padding:24px!important}}</style></head>\n<body style=\"margin:0;background:#F5F6F8;color:#151A30;font-family:'Schibsted Grotesk', Arial, sans-serif;-webkit-text-size-adjust:100%;\">\n<div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all;\">{{summary}}</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" class=\"outer\" style=\"padding:48px 16px;\">\n<!--[if mso]><table role=\"presentation\" width=\"600\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;background:#FFFFFF;border:1px solid #E3E6EC;border-radius:12px;\"><tr><td class=\"content\" style=\"padding:32px;\">\n<p style=\"margin:0 0 32px;color:#1C2A6B;font-size:24px;line-height:30px;font-weight:700;\">Auction NG</p>\n<h1 style=\"margin:0 0 12px;font-size:24px;line-height:30px;\">{{heading}}</h1>\n<p style=\"margin:0 0 24px;font-size:16px;line-height:24px;\">{{summary}}</p>\n<p style=\"margin:0;color:#556074;font-size:14px;line-height:20px;\">Lot {{lotNumber}}</p>\n<h2 style=\"margin:4px 0 24px;font-size:20px;line-height:26px;overflow-wrap:anywhere;\">{{title}}</h2>\n<table aria-label=\"Invoice breakdown\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-top:1px solid #E3E6EC;border-bottom:1px solid #E3E6EC;font-size:14px;line-height:20px;\">\n<tr><th align=\"left\" style=\"padding:12px 0;font-weight:400;color:#556074;\">Winning bid</th><td align=\"right\" style=\"padding:12px 0;font-variant-numeric:tabular-nums;white-space:nowrap;\">{{hammer}}</td></tr><tr><th align=\"left\" style=\"padding:12px 0;font-weight:400;color:#556074;\">Buyer premium</th><td align=\"right\" style=\"padding:12px 0;font-variant-numeric:tabular-nums;white-space:nowrap;\">{{premium}}</td></tr><tr><th align=\"left\" style=\"padding:12px 0;font-weight:400;color:#556074;\">Lot fee</th><td align=\"right\" style=\"padding:12px 0;font-variant-numeric:tabular-nums;white-space:nowrap;\">{{lotFee}}</td></tr><tr><th align=\"left\" style=\"padding:12px 0;font-weight:400;color:#556074;\">VAT on fees</th><td align=\"right\" style=\"padding:12px 0;font-variant-numeric:tabular-nums;white-space:nowrap;\">{{vat}}</td></tr>\n<tr><th align=\"left\" style=\"padding:16px 0;border-top:1px solid #E3E6EC;font-size:16px;\">Total</th><td align=\"right\" style=\"padding:16px 0;border-top:1px solid #E3E6EC;font-size:20px;font-weight:700;font-variant-numeric:tabular-nums;white-space:nowrap;\">{{total}}</td></tr></table>\n<p style=\"margin:16px 0 24px;color:#1C2A6B;font-size:14px;line-height:20px;font-weight:600;\">{{payment}}</p>\n<h2 style=\"margin:0 0 8px;font-size:16px;line-height:24px;\">{{nextHeading}}</h2>\n<p style=\"margin:0 0 16px;font-size:14px;line-height:20px;\">{{next}}</p>\n<p style=\"margin:0 0 24px;font-size:14px;line-height:20px;\"><strong>{{location}}</strong><br>{{address}}</p>\n<p style=\"margin:0;padding-top:16px;border-top:1px solid #E3E6EC;color:#556074;font-size:12px;line-height:16px;overflow-wrap:anywhere;\">Invoice {{invoiceNumber}}<br>Keep your pickup pass private. Auction NG staff will never ask for your sign-in code.</p>\n</td></tr></table><!--[if mso]></td></tr></table><![endif]-->\n<p style=\"margin:24px 16px 0;color:#556074;font-size:12px;line-height:16px;\">Auction NG · Your auction receipt<br>This is an automated message. Please do not reply.</p>\n</td></tr></table></body></html>",
  "text": "Auction NG\n\n{{heading}}\n{{summary}}\n\nLot {{lotNumber}}\n{{title}}\nInvoice {{invoiceNumber}}\n\nWinning bid: {{hammer}}\nBuyer premium: {{premium}}\nLot fee: {{lotFee}}\nVAT on fees: {{vat}}\nTotal: {{total}}\n\n{{payment}}\n\n{{nextHeading}}\n{{next}}\n{{location}}\n{{address}}\n\nKeep your pickup pass private. Auction NG staff will never ask for your sign-in code.\nThis is an automated message. Please do not reply."
}
