{
  "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Saved search — GiddyDeal</title><style>@media only screen and (max-width:600px){.outer{padding:24px 16px!important}.content{padding:24px!important}}</style></head>\n<body style=\"margin:0;background:#F5F6F8;color:#151A30;font-family:'Schibsted Grotesk', Arial, sans-serif;-webkit-text-size-adjust:100%;\">\n<div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all;\">{{heading}}</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"outer\" align=\"center\" style=\"padding:48px 16px;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;background:#FFFFFF;border:1px solid #E3E6EC;border-radius:12px;\"><tr><td class=\"content\" style=\"padding:32px;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 0 24px;background:#1C2A6B;border-bottom:4px solid #FFC629;border-radius:8px\"><tr><td style=\"padding:20px 24px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"background:#FFFFFF;padding:8px 12px;border-radius:8px\"><img src=\"cid:giddydeal-brand-logo\" alt=\"GiddyDeal\" width=\"176\" style=\"display:block;width:176px;max-width:100%;height:auto;border:0;color:#1C2A6B;font-size:22px;font-weight:700\"></td></tr></table><p style=\"margin:14px 0 0;color:#FFC629;font-size:15px;line-height:22px;font-weight:700\">Bid. Win. Save.</p></td></tr></table>\n<h1 style=\"margin:0 0 12px;font-size:24px;line-height:30px;\">{{heading}}</h1>\n<p style=\"margin:0;font-size:16px;line-height:24px;\">{{intro}}</p>\n{{{groups}}}\n<p style=\"margin:32px 0 0;padding-top:16px;border-top:1px solid #E3E6EC;color:#556074;font-size:12px;line-height:16px;\">You received this email because you saved a search on GiddyDeal. Prices can change once bidding starts. <a href=\"{{manageUrl}}\" style=\"color:#556074;\">Manage saved-search emails</a></p>\n</td></tr></table><p style=\"margin:24px 0 0;color:#556074;font-size:12px;\">GiddyDeal · Your saved searches</p></td></tr></table></body></html>",
  "text": "GiddyDeal\n\n{{heading}}\n{{intro}}\n{{{groups}}}\n\nYou received this email because you saved a search on GiddyDeal. Prices can change once bidding starts.\nManage saved-search emails: {{manageUrl}}",
  "group": "<h2 style=\"margin:24px 0 8px;font-size:20px;line-height:26px;overflow-wrap:anywhere;\">{{label}}</h2>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-top:1px solid #E3E6EC;\">{{{items}}}</table>\n<p style=\"margin:8px 0 0;\"><a href=\"{{searchUrl}}\" style=\"color:#1C2A6B;font-weight:600;\">{{more}}</a></p>",
  "groupText": "\n{{label}}\n{{{items}}}{{more}}: {{searchUrl}}\n",
  "item": "<tr><td width=\"88\" valign=\"top\" style=\"padding:12px 16px 12px 0;\"><!--item-image--><a href=\"{{itemUrl}}\"><img src=\"{{imageUrl}}\" alt=\"\" width=\"72\" height=\"72\" style=\"display:block;width:72px;height:72px;object-fit:cover;border:1px solid #E3E6EC;border-radius:8px;\"></a><!--/item-image--></td><td valign=\"top\" style=\"padding:12px 0;\"><a href=\"{{itemUrl}}\" style=\"color:#151A30;font-weight:600;text-decoration:none;overflow-wrap:anywhere;\">{{title}}</a><p style=\"margin:4px 0 0;color:#556074;font-size:14px;line-height:20px;\">Starting price {{price}} · Closes {{closes}}</p></td></tr>",
  "itemText": "- {{title}}. Starting price {{price}}, closes {{closes}}. {{itemUrl}}\n"
}
