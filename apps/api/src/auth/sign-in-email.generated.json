{
  "subject": "Your Auction NG sign-in code",
  "text": "Auction NG\n\nYour sign-in code\n\nEnter this code in the app or website where you requested it:\n\n{{code}}\n\nThis code expires in 5 minutes and can be used once.\n\nKeep your code private. Auction NG staff will never ask you to share it.\n\nIf you did not request this code, you can ignore this email.\n\nAuction NG\nThis is an automated sign-in email. Please do not reply.",
  "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"light\">\n  <title>Your Auction NG sign-in code</title>\n  <style>\n    @media only screen and (max-width: 600px) {\n      .email-content { padding: 24px !important; }\n      .email-outer { padding: 24px 16px !important; }\n    }\n  </style>\n</head>\n<body style=\"margin:0;padding:0;background-color:#F5F6F8;color:#151A30;font-family:'Schibsted Grotesk', Arial, sans-serif;-webkit-text-size-adjust:100%;\">\n  <div style=\"display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">Use your one-time code to sign in. It expires in 5 minutes.</div>\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#F5F6F8;\">\n    <tr><td class=\"email-outer\" align=\"center\" style=\"padding:48px 16px;\">\n      <!--[if mso]><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td><![endif]-->\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;background-color:#FFFFFF;border:1px solid #E3E6EC;border-radius:12px;\">\n        <tr><td class=\"email-content\" style=\"padding:32px;\">\n          <p style=\"margin:0 0 32px;color:#1C2A6B;font-size:24px;line-height:30px;font-weight:700;\">Auction NG</p>\n          <h1 style=\"margin:0 0 12px;font-size:24px;line-height:30px;font-weight:700;\">Your sign-in code</h1>\n          <p style=\"margin:0 0 24px;font-size:16px;line-height:24px;\">Enter this code in the app or website where you requested it.</p>\n          <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#EEF0FA;border:1px solid #E3E6EC;border-radius:8px;\">\n            <tr><td align=\"center\" style=\"padding:24px 16px;\">\n              <p style=\"margin:0;color:#1C2A6B;font-size:32px;line-height:38px;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:4px;\">{{code}}</p>\n            </td></tr>\n          </table>\n          <p style=\"margin:16px 0 24px;color:#556074;font-size:14px;line-height:20px;\">This code expires in <strong>5 minutes</strong> and can be used once.</p>\n          <p style=\"margin:0 0 24px;font-size:14px;line-height:20px;\"><strong>Keep your code private.</strong> Auction NG staff will never ask you to share it.</p>\n          <hr style=\"margin:0 0 24px;border:0;border-top:1px solid #E3E6EC;\">\n          <p style=\"margin:0;color:#556074;font-size:14px;line-height:20px;\">If you did not request this code, you can ignore this email.</p>\n        </td></tr>\n      </table>\n      <!--[if mso]></td></tr></table><![endif]-->\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:600px;\">\n        <tr><td style=\"padding:24px 16px 0;color:#556074;font-size:12px;line-height:16px;text-align:center;\">\n          Auction NG<br>This is an automated sign-in email. Please do not reply.\n        </td></tr>\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>"
}
