{
  "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body style=\"margin:0;background:#F5F6F8;color:#151A30;font-family:'Schibsted Grotesk',Arial,sans-serif\"><table role=\"presentation\" width=\"100%\"><tr><td align=\"center\" style=\"padding:24px 16px\"><table role=\"presentation\" width=\"100%\" style=\"max-width:600px;background:#FFFFFF;border:1px solid #E3E6EC;border-radius:12px\"><tr><td style=\"padding:24px\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0 0 24px;background:#1C2A6B;border-bottom:4px solid #FFC629;border-radius:8px\"><tr><td style=\"padding:20px 24px\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"background:#FFFFFF;padding:8px 12px;border-radius:8px\"><img src=\"cid:lotvanta-brand-logo\" alt=\"LotVanta\" width=\"176\" style=\"display:block;width:176px;max-width:100%;height:auto;border:0;color:#1C2A6B;font-size:22px;font-weight:700\"></td></tr></table><p style=\"margin:14px 0 0;color:#FFC629;font-size:15px;line-height:22px;font-weight:700\">Bid. Win. Save.</p></td></tr></table><h1 style=\"font-size:24px;line-height:30px\">{{heading}}</h1><p style=\"line-height:1.7\">{{message}}</p><p style=\"color:#556074\">Reference {{reference}}</p><p style=\"padding:16px;background:#EEF0FA;border-radius:8px\">{{amountLabel}}: <strong>{{amount}}</strong></p><p><a href=\"{{walletUrl}}\" style=\"display:inline-block;padding:14px 22px;background:#1C2A6B;color:#FFFFFF;border-radius:8px;text-decoration:none;font-weight:700\">View your wallet</a></p><p style=\"font-size:13px;line-height:1.6;color:#556074\">Keep your password and verification codes private.</p></td></tr></table></td></tr></table></body></html>",
