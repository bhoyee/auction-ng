{
  "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Purchase refund</title></head><body style=\"margin:0;background:#F5F6F8;color:#151A30;font-family:'Schibsted Grotesk',Arial,sans-serif\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:24px 16px\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;background:#FFFFFF;border:1px solid #E3E6EC;border-radius:12px\"><tr><td style=\"padding:24px\"><p style=\"margin:0 0 24px;font-size:24px;font-weight:700;color:#1C2A6B\">LotVanta</p><h1 style=\"font-size:24px;line-height:30px\">{{heading}}</h1><p style=\"font-size:16px;line-height:24px\">{{message}}</p><p>Reference <strong>{{reference}}</strong></p><table role=\"presentation\" width=\"100%\" style=\"border-top:1px solid #E3E6EC;border-bottom:1px solid #E3E6EC\"><tr><td style=\"padding:16px 0\">{{amountLabel}}</td><td align=\"right\" style=\"font-weight:700\">{{amount}}</td></tr></table><p style=\"margin:24px 0\"><a href=\"{{walletUrl}}\" style=\"display:inline-block;padding:16px 24px;background:#1C2A6B;color:#FFFFFF;border-radius:8px;text-decoration:none;font-weight:600\">View your wallet</a></p><p style=\"font-size:14px;line-height:20px;color:#556074\">Questions about this refund? Contact our support team. Never share your password or email verification code.</p></td></tr></table></td></tr></table></body></html>",
