generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Daily materialised views are SQL-managed in the Overview read-model migration.
// This singleton carries only derived operational counts and redacted activity.
model AnalyticsSnapshot {
  id Int @id @db.SmallInt
  generatedAt DateTime @map("generated_at") @db.Timestamptz(3)
  metricsAt DateTime? @map("metrics_at") @db.Timestamptz(3)
  payload Json @db.JsonB
  @@map("analytics_snapshots")
}

model AuctionFeePolicy {
  preBids PreBid[]
  version String @id @db.VarChar(40)
  revision Int @unique
  serviceChargeEnabled Boolean @map("service_charge_enabled")
  premiumBps Int @map("premium_bps")
  lotFeeEnabled Boolean @map("lot_fee_enabled")
  lotFeeKobo BigInt @map("lot_fee_kobo")
  vatEnabled Boolean @map("vat_enabled")
  vatBps Int @map("vat_bps")
  createdById String? @map("created_by_id") @db.Uuid
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lots Lot[]
  intents BidFundingIntent[]
  settlements LotSettlement[]
  controls AuctionFeeControls[]
  @@map("auction_fee_policies")
}

model AuctionFeeControls {
  id Int @id
  currentVersion String @map("current_version") @db.VarChar(40)
  policy AuctionFeePolicy @relation(fields: [currentVersion], references: [version], onDelete: Restrict, onUpdate: Restrict)
  @@map("auction_fee_controls")
}

model PreBid {
 @@index([lotId,createdAt,id],map:"pre_bids_staff_review_idx")
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 lotId String @map("lot_id") @db.Uuid
 userId String @map("user_id") @db.Uuid
 sessionId String @map("session_id") @db.Uuid
 walletId String @map("wallet_id") @db.Uuid
 holdId String @unique @map("hold_id") @db.Uuid
 feeVersion String @map("fee_version") @db.VarChar(40)
 maxKobo BigInt @map("max_kobo")
 totalKobo BigInt @map("total_kobo")
 revision Int @default(1)
 scheduleVersion Int @map("schedule_version")
 priority BigInt @unique @default(autoincrement())
 status String @default("active") @db.VarChar(16)
 intentId String? @unique @map("intent_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
 updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
 lot Lot @relation(fields:[lotId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 session AuthSession @relation(fields:[sessionId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 wallet Wallet @relation(fields:[walletId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 hold WalletHold @relation(fields:[holdId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 feePolicy AuctionFeePolicy @relation(fields:[feeVersion],references:[version],onDelete:Restrict,onUpdate:Restrict)
 intent BidFundingIntent? @relation(fields:[intentId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 @@unique([lotId,userId])
 @@index([lotId,status,priority,id],map:"pre_bids_launch_idx")
 @@index([status,updatedAt,id],map:"pre_bids_reconcile_idx")
 @@index([userId,createdAt,id],map:"pre_bids_buyer_history_idx")
 @@map("pre_bids")
}

model User {
  locationAssignments LocationStaff[]
  lotControls LotControlCommand[]
  lotBidderMessages LotBidderMessage[]
  auctionPauseCommands AuctionPauseCommand[]
  storageCases PickupStorageCase[] @relation("StorageBuyer")
  storageAssigned PickupStorageCase[] @relation("StorageAssignee")
  storageActions PickupStorageAdjustment[]
  storagePayments PickupStoragePayment[]
  staffPreferences Json @default("{}") @map("staff_preferences") @db.JsonB
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  staffMembership StaffMembership?
  staffInvitations StaffInvitation[]
  staffActions StaffAction[]
  staffRolesCreated StaffRole[]
  staffRefunds StaffRefund[]

  nativePushDevices NativePushDevice[]
  cancellationsRequested BidCancellationApproval[] @relation("CancellationBuyer")
  cancellationsApproved BidCancellationApproval[] @relation("CancellationStaff")
  preBids PreBid[]
  auctionFeePolicies AuctionFeePolicy[]
  supportConversations SupportConversation[] @relation("SupportBuyer")
  createdSupportConversations SupportConversation[] @relation("SupportCreator")
  assignedSupportConversations SupportConversation[] @relation("SupportAssignee")
  supportMessages SupportMessage[]
  supportPresence SupportPresence?
  authenticatorEnabled Boolean @default(false) @map("authenticator_enabled")
  authenticatorVersion Int @default(0) @map("authenticator_version")
  buyerAuthenticator BuyerAuthenticator?
  recoveryCodes AuthRecoveryCode[]
  securityChallenges AccountSecurityChallenge[]
  withdrawalBanks WithdrawalBank[]
  withdrawalBankChanges WithdrawalBankChange[]
  withdrawals Withdrawal[]
  buyerPasswordHash String? @map("buyer_password_hash") @db.Text
  addressCiphertext Bytes? @map("address_ciphertext")
  purchases Purchase[]
  staffCredential StaffCredential?
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String           @db.VarChar(120)
  phoneCiphertext   Bytes?           @map("phone_ciphertext")
  phoneHash         String?          @unique @map("phone_hash") @db.VarChar(64)
  emailCiphertext   Bytes?           @map("email_ciphertext")
  emailHash         String?          @unique @map("email_hash") @db.VarChar(64)
  bvnCiphertext     Bytes?           @map("bvn_ciphertext")
  bvnHash           String?          @unique @map("bvn_hash") @db.VarChar(64)
  walletConsentedAt DateTime?        @map("wallet_consented_at") @db.Timestamptz(3)
  topupFeePolicy    String?          @map("topup_fee_policy") @db.VarChar(40)
  role              String           @default("buyer") @db.VarChar(24)
  status            String           @default("active") @db.VarChar(24)
  kycStatus         String           @default("unverified") @map("kyc_status") @db.VarChar(24)
  phoneVerifiedAt   DateTime?        @map("phone_verified_at") @db.Timestamptz(3)
  emailVerifiedAt   DateTime?        @map("email_verified_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  wallet            Wallet?
  virtualAccounts   VirtualAccount[]
  payments          Payment[]
  bids              Bid[]
  watchlist         Watchlist[]
  invoices          Invoice[]
  fulfilments       Fulfilment[]
  pickupArrivals    PickupArrival[] @relation("ArrivalBuyer")
  handledArrivals   PickupArrival[] @relation("ArrivalHandler")
  pickupVisits      PickupVisit[] @relation("VisitBuyer")
  registeredVisits  PickupVisit[] @relation("VisitRegistrar")
  pickupVisitPasses PickupVisitPass[]
  pickupReceipts    PickupCollectionReceipt[]
  notifications     Notification[]
  strikes           Strike[]         @relation("StrikeSubject")
  issuedStrikes     Strike[]         @relation("StrikeActor")
  auditLogs         AuditLog[]
  imageUploads      ImageUpload[]
  idempotencyKeys   IdempotencyKey[]
  authSessions      AuthSession[]
  bidFundingIntents BidFundingIntent[]
  settlements LotSettlement[]

  @@index([role, id])
  @@index([archivedAt, createdAt, id], map: "users_archive_created_idx")
  @@map("users")
}

model SupportConversation {
  bidCancellationFeeConsentAt DateTime? @map("bid_cancellation_fee_consent_at") @db.Timestamptz(3)
  cancellationApprovals BidCancellationApproval[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number String @unique @db.VarChar(12)
  buyerId String @map("buyer_id") @db.Uuid
  buyer User @relation("SupportBuyer", fields: [buyerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdById String @map("created_by_id") @db.Uuid
  createdBy User @relation("SupportCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assigneeId String? @map("assignee_id") @db.Uuid
  assignee User? @relation("SupportAssignee", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createKey String @map("create_key") @db.Uuid
  requestHash String @map("request_hash") @db.VarChar(64)
  subjectCiphertext Bytes @map("subject_ciphertext")
  referenceCiphertext Bytes @map("reference_ciphertext")
  topic String @db.VarChar(24)
  status String @default("open") @db.VarChar(24)
  mode String @default("assistant") @db.VarChar(16)
  version Int @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  messages SupportMessage[]
  @@unique([createdById, createKey])
  @@index([buyerId, status, updatedAt, id])
  @@index([buyerId, updatedAt, id])
  @@index([status, updatedAt, id])
  @@index([updatedAt, id])
  @@index([assigneeId, status, id])
  @@map("support_conversations")
}
model SupportMessage {
  sequence Int
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid
  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  authorId String? @map("author_id") @db.Uuid
  author User? @relation(fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  kind String @db.VarChar(16)
  internal Boolean @default(false)
  bodyCiphertext Bytes @map("body_ciphertext")
  requestKey String @map("request_key") @db.Uuid
  requestHash String @map("request_hash") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  attachments SupportAttachment[]
  @@unique([conversationId, requestKey])
  @@unique([conversationId, sequence])
  @@index([conversationId, internal, createdAt, id])
  @@index([conversationId, internal, sequence])
  @@index([authorId, createdAt, id])
  @@map("support_messages")
}
model SupportAttachment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String @map("message_id") @db.Uuid
  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contentCiphertext Bytes? @map("content_ciphertext")
  objectKey String? @unique @map("object_key") @db.VarChar(240)
  bytes Int
  @@index([messageId, id])
  @@index([objectKey, id])
  @@map("support_attachments")
}
model SupportPresence {
  userId String @id @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accepting Boolean @default(false)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@index([accepting, expiresAt])
  @@map("support_presence")
}

model AuthChallenge {
  purpose String @default("legacy") @db.VarChar(16)
  passwordHash String? @map("password_hash") @db.Text
  pendingName String? @map("pending_name") @db.VarChar(120)
  id              String    @id @db.Uuid
  emailHash       String    @map("email_hash") @db.VarChar(64)
  emailCiphertext Bytes     @map("email_ciphertext")
  codeHash        String    @map("code_hash") @db.VarChar(64)
  deviceHash      String    @map("device_hash") @db.VarChar(64)
  client          String    @db.VarChar(8)
  attempts        Int       @default(0)
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([emailHash, createdAt, id])
  @@index([expiresAt, id])
  @@map("auth_challenges")
}

model AuthSession {
  nativePushDevices NativePushDevice[]
  preBids PreBid[]
  authenticatorVersion Int @default(0) @map("authenticator_version")
  securityChallenges AccountSecurityChallenge[]
  withdrawalBankChanges WithdrawalBankChange[]
  withdrawals Withdrawal[]
  buyerMfa Boolean @default(false) @map("buyer_mfa")
  staffMfa        Boolean   @default(false) @map("staff_mfa")
  staffAuthenticated Boolean @default(false) @map("staff_authenticated")
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  deviceHash      String    @map("device_hash") @db.VarChar(64)
  client          String    @db.VarChar(8)
  accessHash      String    @unique @map("access_hash") @db.VarChar(64)
  refreshHash     String    @unique @map("refresh_hash") @db.VarChar(64)
  accessExpiresAt DateTime  @map("access_expires_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bidFundingIntents BidFundingIntent[]

  @@index([userId, createdAt, id])
  @@index([familyId, id])
  @@unique([id,userId])
  @@index([expiresAt, id])
  @@map("auth_sessions")
}

model StaffCredential {
  userId String @id @map("user_id") @db.Uuid
  passwordHash String @map("password_hash") @db.Text
  totpSecretCiphertext Bytes? @map("totp_secret_ciphertext")
  lastCounter BigInt? @map("last_counter")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@map("staff_credentials")
}

model BuyerAuthenticator {
  userId String @id @map("user_id") @db.Uuid
  secretCiphertext Bytes @map("secret_ciphertext")
  lastCounter BigInt? @map("last_counter")
  enabledAt DateTime @default(now()) @map("enabled_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@map("buyer_authenticators")
}

model AuthRecoveryCode {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  codeHash String @unique @map("code_hash") @db.VarChar(64)
  usedAt DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([userId, usedAt, id])
  @@map("auth_recovery_codes")
}

model AccountSecurityChallenge {
  id String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  purpose String @db.VarChar(24)
  payloadCiphertext Bytes @map("payload_ciphertext")
  codeHash String @map("code_hash") @db.VarChar(64)
  attempts Int @default(0)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([userId, createdAt, id])
  @@index([sessionId])
  @@index([expiresAt, id])
  @@map("account_security_challenges")
}

model AuthRateLimit {
  key       String   @id @db.VarChar(64)
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_rate_limits")
}

model Wallet {
  preBids PreBid[]
  withdrawals Withdrawal[]
  purchases Purchase[]
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String              @unique @map("user_id") @db.Uuid
  currency           String              @default("NGN") @db.VarChar(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accounts           LedgerAccount[]
  payments           Payment[]
  ledgerTransactions LedgerTransaction[]
  holds              WalletHold[]
  bidFundingIntents BidFundingIntent[]

  @@unique([id, userId])
  @@map("wallets")
}

model LedgerAccount {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String        @unique @db.VarChar(120)
  walletId  String?       @map("wallet_id") @db.Uuid
  kind      String        @db.VarChar(24)
  currency  String        @default("NGN") @db.VarChar(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  wallet    Wallet?       @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entries   LedgerEntry[]

  @@unique([walletId, kind])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  storagePayment PickupStoragePayment?
  withdrawals Withdrawal[] @relation("WithdrawalPayout")
  bankAvailableDeltaKobo BigInt @default(0) @map("bank_available_delta_kobo")
  bankHeldDeltaKobo BigInt @default(0) @map("bank_held_delta_kobo")
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey      String              @unique @map("idempotency_key") @db.VarChar(160)
  reference           String              @unique @db.VarChar(160)
  type                String              @db.VarChar(24)
  currency            String              @default("NGN") @db.VarChar(3)
  writerXid           BigInt              @default(dbgenerated("txid_current()")) @map("writer_xid")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  entries             LedgerEntry[]
  walletId            String?             @map("wallet_id") @db.Uuid
  operation           String?             @db.VarChar(24)
  amountKobo          BigInt?             @map("amount_kobo")
  requestHash         String?             @map("request_hash") @db.VarChar(64)
  availableDeltaKobo  BigInt?             @map("available_delta_kobo")
  heldDeltaKobo       BigInt?             @map("held_delta_kobo")
  holdId              String?             @map("hold_id") @db.Uuid
  sourceTransactionId String?             @map("source_transaction_id") @db.Uuid
  wallet              Wallet?             @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  hold                WalletHold?         @relation(fields: [holdId, walletId], references: [id, walletId], onDelete: Restrict, onUpdate: Restrict)
  sourceTransaction   LedgerTransaction?  @relation("RefundSource", fields: [sourceTransactionId, walletId], references: [id, walletId], onDelete: Restrict, onUpdate: Restrict)
  refunds             LedgerTransaction[] @relation("RefundSource")

  @@unique([id, walletId])
  @@index([createdAt, id])
  @@index([walletId, createdAt, id])
  @@index([holdId, walletId])
  @@index([sourceTransactionId, walletId])
  @@map("ledger_transactions")
}

model WalletHold {
  preBid PreBid?
  withdrawal Withdrawal?
  bankAmountKobo BigInt @default(0) @map("bank_amount_kobo")
  id           String              @id @db.Uuid
  walletId     String              @map("wallet_id") @db.Uuid
  amountKobo   BigInt              @map("amount_kobo")
  status       String              @default("active") @db.VarChar(24)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  wallet       Wallet              @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactions LedgerTransaction[]
  bidFundingIntent BidFundingIntent?

  @@unique([id, walletId])
  @@index([walletId, status, id])
  @@map("wallet_holds")
}

model LedgerEntry {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId  String            @map("transaction_id") @db.Uuid
  accountId      String            @map("account_id") @db.Uuid
  amountKobo     BigInt            @map("amount_kobo")
  side           String            @db.VarChar(6)
  idempotencyKey String            @unique @map("idempotency_key") @db.VarChar(200)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  transaction    LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account        LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([transactionId])
  @@index([accountId, createdAt, id])
  @@map("ledger_entries")
}

model VirtualAccount {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  provider                String   @db.VarChar(24)
  providerRef             String   @map("provider_ref") @db.VarChar(160)
  customerCode            String?  @unique @map("customer_code") @db.VarChar(160)
  bankName                String   @map("bank_name") @db.VarChar(120)
  accountNumberCiphertext Bytes    @map("account_number_ciphertext")
  consentedAt             DateTime @map("consented_at") @db.Timestamptz(3)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user                    User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, providerRef])
  @@index([userId, id])
  @@map("virtual_accounts")
}

model Payment {
  checkoutCancelledAt       DateTime? @map("checkout_cancelled_at") @db.Timestamptz(3)
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                    String    @map("user_id") @db.Uuid
  walletId                  String    @map("wallet_id") @db.Uuid
  provider                  String    @db.VarChar(24)
  providerRef               String    @map("provider_ref") @db.VarChar(160)
  amountKobo                BigInt    @map("amount_kobo")
  feeKobo                   BigInt?   @map("fee_kobo")
  creditKobo                BigInt?   @map("credit_kobo")
  fundingMethod             String?   @map("funding_method") @db.VarChar(24)
  feePolicy                 String?   @map("fee_policy") @db.VarChar(40)
  cardType                  String?   @map("card_type") @db.VarChar(16)
  initializationKey         String?   @unique @map("initialization_key") @db.VarChar(200)
  checkoutUrlCiphertext     Bytes?    @map("checkout_url_ciphertext")
  initializationAttemptedAt DateTime? @map("initialization_attempted_at") @db.Timestamptz(3)
  consentedAt               DateTime? @map("consented_at") @db.Timestamptz(3)
  currency                  String    @default("NGN") @db.VarChar(3)
  status                    String    @default("pending") @db.VarChar(24)
  rawWebhookCiphertext      Bytes?    @map("raw_webhook_ciphertext")
  verifiedAt                DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user                      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  wallet                    Wallet    @relation(fields: [walletId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, providerRef])
  @@index([userId, createdAt, id])
  @@index([walletId, createdAt, id])
  @@index([status, createdAt, id])
  @@map("payments")
}

model Location {
  landmark String? @db.VarChar(160)
  phone String? @db.VarChar(20)
  lat Decimal? @db.Decimal(9, 6)
  lng Decimal? @db.Decimal(9, 6)
  status String @default("open") @db.VarChar(8)
