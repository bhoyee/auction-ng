 user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
 wallet Wallet @relation(fields:[walletId,userId],references:[id,userId],onDelete:Restrict,onUpdate:Restrict)
 bank WithdrawalBank @relation(fields:[bankId,userId],references:[id,userId],onDelete:Restrict,onUpdate:Restrict)
 hold WalletHold? @relation(fields:[holdId,walletId],references:[id,walletId],onDelete:Restrict,onUpdate:Restrict)
 payout LedgerTransaction? @relation("WithdrawalPayout",fields:[payoutId,walletId],references:[id,walletId],onDelete:Restrict,onUpdate:Restrict)
 session AuthSession @relation(fields:[sessionId,userId],references:[id,userId],onDelete:Restrict,onUpdate:Restrict)
 @@unique([userId,requestKey])
 @@unique([holdId,walletId])
 @@index([userId,createdAt,id])
 @@index([userId,confirmedAt,status,id])
 @@index([status,checkedAt,id])
 @@map("withdrawals")
}

