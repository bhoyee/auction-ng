generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  staffCredential StaffCredential?
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String           @db.VarChar(120)
  phoneCiphertext   Bytes?           @map("phone_ciphertext")
  phoneHash         String?          @unique @map("phone_hash") @db.VarChar(64)
  emailCiphertext   Bytes?           @map("email_ciphertext")
  emailHash         String?          @unique @map("email_hash") @db.VarChar(64)
  bvnCiphertext     Bytes?           @map("bvn_ciphertext")
  bvnHash           String?          @unique @map("bvn_hash") @db.VarChar(64)
  walletConsentedAt DateTime?        @map("wallet_consented_at") @db.Timestamptz(3)
  topupFeePolicy    String?          @map("topup_fee_policy") @db.VarChar(40)
  role              String           @default("buyer") @db.VarChar(24)
  status            String           @default("active") @db.VarChar(24)
  kycStatus         String           @default("unverified") @map("kyc_status") @db.VarChar(24)
  phoneVerifiedAt   DateTime?        @map("phone_verified_at") @db.Timestamptz(3)
  emailVerifiedAt   DateTime?        @map("email_verified_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  wallet            Wallet?
  virtualAccounts   VirtualAccount[]
  payments          Payment[]
  bids              Bid[]
  watchlist         Watchlist[]
  invoices          Invoice[]
  fulfilments       Fulfilment[]
  notifications     Notification[]
  strikes           Strike[]         @relation("StrikeSubject")
  issuedStrikes     Strike[]         @relation("StrikeActor")
  auditLogs         AuditLog[]
  imageUploads      ImageUpload[]
  idempotencyKeys   IdempotencyKey[]
  authSessions      AuthSession[]
  bidFundingIntents BidFundingIntent[]
  settlements LotSettlement[]

  @@index([role, id])
  @@map("users")
}

model AuthChallenge {
  id              String    @id @db.Uuid
  emailHash       String    @map("email_hash") @db.VarChar(64)
  emailCiphertext Bytes     @map("email_ciphertext")
  codeHash        String    @map("code_hash") @db.VarChar(64)
  deviceHash      String    @map("device_hash") @db.VarChar(64)
  client          String    @db.VarChar(8)
  attempts        Int       @default(0)
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([emailHash, createdAt, id])
  @@index([expiresAt, id])
  @@map("auth_challenges")
}

model AuthSession {
  staffMfa        Boolean   @default(false) @map("staff_mfa")
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  deviceHash      String    @map("device_hash") @db.VarChar(64)
  client          String    @db.VarChar(8)
  accessHash      String    @unique @map("access_hash") @db.VarChar(64)
  refreshHash     String    @unique @map("refresh_hash") @db.VarChar(64)
  accessExpiresAt DateTime  @map("access_expires_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  bidFundingIntents BidFundingIntent[]

  @@index([userId, createdAt, id])
  @@index([familyId, id])
  @@unique([id,userId])
  @@index([expiresAt, id])
  @@map("auth_sessions")
}

model StaffCredential {
  userId String @id @map("user_id") @db.Uuid
  passwordHash String @map("password_hash") @db.Text
  totpSecretCiphertext Bytes @map("totp_secret_ciphertext")
  lastCounter BigInt? @map("last_counter")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@map("staff_credentials")
}

model AuthRateLimit {
  key       String   @id @db.VarChar(64)
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_rate_limits")
}

model Wallet {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String              @unique @map("user_id") @db.Uuid
  currency           String              @default("NGN") @db.VarChar(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accounts           LedgerAccount[]
  payments           Payment[]
  ledgerTransactions LedgerTransaction[]
  holds              WalletHold[]
  bidFundingIntents BidFundingIntent[]

  @@unique([id, userId])
  @@map("wallets")
}

model LedgerAccount {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String        @unique @db.VarChar(120)
  walletId  String?       @map("wallet_id") @db.Uuid
  kind      String        @db.VarChar(24)
  currency  String        @default("NGN") @db.VarChar(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  wallet    Wallet?       @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entries   LedgerEntry[]

  @@unique([walletId, kind])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotencyKey      String              @unique @map("idempotency_key") @db.VarChar(160)
  reference           String              @unique @db.VarChar(160)
  type                String              @db.VarChar(24)
  currency            String              @default("NGN") @db.VarChar(3)
  writerXid           BigInt              @default(dbgenerated("txid_current()")) @map("writer_xid")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  entries             LedgerEntry[]
  walletId            String?             @map("wallet_id") @db.Uuid
  operation           String?             @db.VarChar(24)
  amountKobo          BigInt?             @map("amount_kobo")
  requestHash         String?             @map("request_hash") @db.VarChar(64)
  availableDeltaKobo  BigInt?             @map("available_delta_kobo")
  heldDeltaKobo       BigInt?             @map("held_delta_kobo")
  holdId              String?             @map("hold_id") @db.Uuid
  sourceTransactionId String?             @map("source_transaction_id") @db.Uuid
  wallet              Wallet?             @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  hold                WalletHold?         @relation(fields: [holdId, walletId], references: [id, walletId], onDelete: Restrict, onUpdate: Restrict)
  sourceTransaction   LedgerTransaction?  @relation("RefundSource", fields: [sourceTransactionId, walletId], references: [id, walletId], onDelete: Restrict, onUpdate: Restrict)
  refunds             LedgerTransaction[] @relation("RefundSource")

  @@unique([id, walletId])
  @@index([createdAt, id])
  @@index([walletId, createdAt, id])
  @@index([holdId, walletId])
  @@index([sourceTransactionId, walletId])
  @@map("ledger_transactions")
}

model WalletHold {
  id           String              @id @db.Uuid
  walletId     String              @map("wallet_id") @db.Uuid
  amountKobo   BigInt              @map("amount_kobo")
  status       String              @default("active") @db.VarChar(24)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  wallet       Wallet              @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transactions LedgerTransaction[]
  bidFundingIntent BidFundingIntent?

  @@unique([id, walletId])
  @@index([walletId, status, id])
  @@map("wallet_holds")
}

model LedgerEntry {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId  String            @map("transaction_id") @db.Uuid
  accountId      String            @map("account_id") @db.Uuid
  amountKobo     BigInt            @map("amount_kobo")
  side           String            @db.VarChar(6)
  idempotencyKey String            @unique @map("idempotency_key") @db.VarChar(200)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  transaction    LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  account        LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([transactionId])
  @@index([accountId, createdAt, id])
  @@map("ledger_entries")
}

model VirtualAccount {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  provider                String   @db.VarChar(24)
  providerRef             String   @map("provider_ref") @db.VarChar(160)
  customerCode            String?  @unique @map("customer_code") @db.VarChar(160)
  bankName                String   @map("bank_name") @db.VarChar(120)
  accountNumberCiphertext Bytes    @map("account_number_ciphertext")
  consentedAt             DateTime @map("consented_at") @db.Timestamptz(3)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user                    User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, providerRef])
  @@index([userId, id])
  @@map("virtual_accounts")
}

model Payment {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                    String    @map("user_id") @db.Uuid
  walletId                  String    @map("wallet_id") @db.Uuid
  provider                  String    @db.VarChar(24)
  providerRef               String    @map("provider_ref") @db.VarChar(160)
  amountKobo                BigInt    @map("amount_kobo")
  feeKobo                   BigInt?   @map("fee_kobo")
  creditKobo                BigInt?   @map("credit_kobo")
  fundingMethod             String?   @map("funding_method") @db.VarChar(24)
  feePolicy                 String?   @map("fee_policy") @db.VarChar(40)
  cardType                  String?   @map("card_type") @db.VarChar(16)
  initializationKey         String?   @unique @map("initialization_key") @db.VarChar(200)
  checkoutUrlCiphertext     Bytes?    @map("checkout_url_ciphertext")
  initializationAttemptedAt DateTime? @map("initialization_attempted_at") @db.Timestamptz(3)
  consentedAt               DateTime? @map("consented_at") @db.Timestamptz(3)
  currency                  String    @default("NGN") @db.VarChar(3)
  status                    String    @default("pending") @db.VarChar(24)
  rawWebhookCiphertext      Bytes?    @map("raw_webhook_ciphertext")
  verifiedAt                DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user                      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  wallet                    Wallet    @relation(fields: [walletId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([provider, providerRef])
  @@index([userId, createdAt, id])
  @@index([walletId, createdAt, id])
  @@index([status, createdAt, id])
  @@map("payments")
}

model Location {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String       @unique @db.VarChar(32)
  name            String       @db.VarChar(120)
  address         String       @db.Text
  hours           Json         @db.JsonB
  capacityPerSlot Int          @map("capacity_per_slot")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lots            Lot[]
  fulfilments     Fulfilment[]

  @@map("locations")
}

model Category {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String     @db.VarChar(100)
  slug     String     @unique @db.VarChar(120)
  parentId String?    @map("parent_id") @db.Uuid
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children Category[] @relation("CategoryTree")
  lots     Lot[]

  @@index([parentId, id])
  @@map("categories")
}

model Lot {
  isTopDeal       Boolean       @default(false) @map("is_top_deal")
  topDealOrder    Int           @default(0) @map("top_deal_order")
  settlement LotSettlement? @relation("SettledLot")
  relistedFrom LotSettlement? @relation("RelistedLot")
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotNumber       String        @unique @default(dbgenerated("next_auction_reference('lot'::text)")) @map("lot_number") @db.VarChar(40)
  title           String        @db.VarChar(200)
  description     String        @db.Text
  condition       String        @db.VarChar(24)
  retailPriceKobo BigInt        @map("retail_price_kobo")
  startPriceKobo  BigInt        @map("start_price_kobo")
  categoryId      String        @map("category_id") @db.Uuid
  locationId      String        @map("location_id") @db.Uuid
  startAt         DateTime      @map("start_at") @db.Timestamptz(3)
  endAt           DateTime      @map("end_at") @db.Timestamptz(3)
  status          String        @default("draft") @db.VarChar(24)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location        Location      @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  images          LotImage[]
  imageUploads    ImageUpload[]
  searchIndexJob  SearchIndexJob?
  bidFundingIntents BidFundingIntent[]
  bids            Bid[]
  watchlist       Watchlist[]
  invoiceLines    InvoiceLine[]

  @@index([status, endAt, id])
  @@index([isTopDeal, topDealOrder, id], map: "lots_top_deal_order_idx")
  @@index([categoryId, status, endAt, id])
  @@index([locationId, status, endAt, id])
  @@index([status, startPriceKobo, endAt, id])
  @@map("lots")
}

model LotImage {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId     String @map("lot_id") @db.Uuid
  url       String @db.Text
  sortOrder Int    @map("sort_order")
  thumbnailUrl String? @map("thumbnail_url") @db.Text
  width Int?
  height Int?
  thumbnailBytes Int? @map("thumbnail_bytes")
  lot       Lot    @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([lotId, sortOrder])
  @@map("lot_images")
}

model ImageUpload {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId String @map("lot_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  requestKey String @unique @map("request_key") @db.VarChar(80)
  objectKey String @unique @map("object_key") @db.VarChar(200)
  contentType String @map("content_type") @db.VarChar(24)
  sizeBytes Int @map("size_bytes")
  sha256 String @db.VarChar(64)
  sortOrder Int @map("sort_order")
  status String @default("pending") @db.VarChar(16)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lot Lot @relation(fields:[lotId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict,onUpdate:Restrict)

  @@index([lotId, status, expiresAt])
  @@map("image_uploads")
}

model SearchIndexJob {
  lotId String @id @map("lot_id") @db.Uuid
  version BigInt @default(dbgenerated("nextval('search_index_revision_seq'::regclass)"))
  appliedVersion BigInt @default(0) @map("applied_version")
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  lot Lot @relation(fields:[lotId],references:[id],onDelete:Restrict,onUpdate:Restrict)

  @@map("search_index_jobs")
}

model BidEngineRuntime {
  namespace String @id @db.VarChar(160)
  redisRunId String @map("redis_run_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  intents BidFundingIntent[]
  acceptances BidAcceptance[]
  closingCursor ClosingCursor?
  settlements LotSettlement[]
  @@map("bid_engine_runtime")
}

model BidFundingIntent {
  id String @id @db.Uuid
  acceptance BidAcceptance?
  userId String @map("user_id") @db.Uuid
  sessionId String @map("session_id") @db.Uuid
  walletId String @map("wallet_id") @db.Uuid
  lotId String @map("lot_id") @db.Uuid
  holdId String? @unique @map("hold_id") @db.Uuid
  groupId String @map("group_id") @db.Uuid
  requestKey String @map("request_key") @db.Uuid
  requestHash String @map("request_hash") @db.VarChar(64)
  binding String @db.VarChar(64)
  namespace String @db.VarChar(160)
  maxKobo BigInt @map("max_kobo")
  mode String @default("automatic") @map("bid_mode") @db.VarChar(16)
  totalKobo BigInt @map("total_kobo")
  reservedKobo BigInt @map("reserved_kobo")
  baseMaxKobo BigInt? @map("base_max_kobo")
  feeVersion String @map("fee_version") @db.VarChar(40)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  status String @default("pending") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  session AuthSession @relation(fields:[sessionId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  wallet Wallet @relation(fields:[walletId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  lot Lot @relation(fields:[lotId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  hold WalletHold? @relation(fields:[holdId,walletId],references:[id,walletId],onDelete:Restrict,onUpdate:Restrict)
  runtime BidEngineRuntime @relation(fields:[namespace],references:[namespace],onDelete:Restrict,onUpdate:Restrict)
  @@unique([holdId,walletId])
  @@unique([userId,requestKey])
  @@index([namespace,status,expiresAt,id],map:"bid_funding_pending_idx")
  @@index([groupId,status,id],map:"bid_funding_group_idx")
  @@index([sessionId,status,id],map:"bid_funding_session_idx")
  @@index([lotId,createdAt,id],map:"bid_funding_lot_idx")
  @@index([walletId,id],map:"bid_funding_wallet_idx")
  @@index([userId,createdAt,id],map:"bid_funding_user_created_idx")
  @@map("bid_funding_intents")
}

model Bid {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lotId          String   @map("lot_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  amountKobo     BigInt   @map("amount_kobo")
  maxKobo        BigInt   @map("max_kobo")
  isProxy        Boolean  @default(false) @map("is_proxy")
  acceptanceId String? @map("acceptance_id") @db.Uuid
  role String? @db.VarChar(16)
  acceptance BidAcceptance? @relation(fields:[acceptanceId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(160)
  streamId       String?  @unique @map("stream_id") @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lot            Lot      @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([lotId, amountKobo(sort: Desc)])
  @@index([lotId, createdAt, id])
  @@index([userId, createdAt, id])
  @@map("bids")
  @@unique([acceptanceId,role])
}

model BidAcceptance {
  id String @id @db.Uuid
  namespace String @db.VarChar(160)
  streamId String @map("stream_id") @db.VarChar(80)
  fingerprint String @db.VarChar(64)
  result Json @db.JsonB
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  intent BidFundingIntent @relation(fields:[id],references:[id],onDelete:Restrict,onUpdate:Restrict)
  runtime BidEngineRuntime @relation(fields:[namespace],references:[namespace],onDelete:Restrict,onUpdate:Restrict)
  bids Bid[]
  @@unique([namespace,streamId])
  @@map("bid_acceptances")
}

model Watchlist {
  userId    String   @map("user_id") @db.Uuid
  lotId     String   @map("lot_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, lotId])
  @@index([lotId, userId])
  @@index([userId, createdAt, lotId])
  @@map("watchlist")
}

model Invoice {
  settlement LotSettlement?
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number          String        @unique @default(dbgenerated("next_auction_reference('invoice'::text)")) @db.VarChar(40)
  userId          String        @map("user_id") @db.Uuid
  hammerTotalKobo BigInt        @map("hammer_total_kobo")
  premiumKobo     BigInt        @map("premium_kobo")
  lotFeeKobo      BigInt        @map("lot_fee_kobo")
  vatKobo         BigInt        @map("vat_kobo")
  totalKobo       BigInt        @map("total_kobo")
  currency        String        @default("NGN") @db.VarChar(3)
  status          String        @default("pending") @db.VarChar(24)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lines           InvoiceLine[]
  fulfilment      Fulfilment?

  @@unique([id, userId])
  @@index([userId, createdAt, id])
  @@index([status, createdAt, id])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  lotId       String  @unique @map("lot_id") @db.Uuid
  hammerKobo  BigInt  @map("hammer_kobo")
  premiumKobo BigInt  @map("premium_kobo")
  lotFeeKobo  BigInt  @map("lot_fee_kobo")
  vatKobo     BigInt  @map("vat_kobo")
  totalKobo   BigInt  @map("total_kobo")
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  lot         Lot     @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([invoiceId, id])
  @@map("invoice_lines")
}

model Fulfilment {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId                 String    @unique @map("invoice_id") @db.Uuid
  userId                    String    @map("user_id") @db.Uuid
  locationId                String    @map("location_id") @db.Uuid
  type                      String    @default("pickup") @db.VarChar(24)
  status                    String    @default("pending") @db.VarChar(24)
  slotAt                    DateTime? @map("slot_at") @db.Timestamptz(3)
  qrTokenHash               String?   @unique @map("qr_token_hash") @db.VarChar(64)
  qrTokenCiphertext         Bytes?    @map("qr_token_ciphertext")
  deliveryAddressCiphertext Bytes?    @map("delivery_address_ciphertext")
  courier                   String?   @db.VarChar(80)
  trackingNumberCiphertext  Bytes?    @map("tracking_number_ciphertext")
  collectedAt               DateTime? @map("collected_at") @db.Timestamptz(3)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  invoice                   Invoice   @relation(fields: [invoiceId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Restrict)
  user                      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location                  Location  @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([invoiceId, userId])
  @@index([locationId, slotAt, id])
  @@index([userId, createdAt, id])
  @@map("fulfilments")
}

model Notification {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference         String?   @unique @db.VarChar(160)
  userId            String    @map("user_id") @db.Uuid
  channel           String    @db.VarChar(24)
  template          String    @db.VarChar(80)
  payloadCiphertext Bytes     @map("payload_ciphertext")
  status            String    @default("pending") @db.VarChar(24)
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, createdAt, id])
  @@index([status, createdAt, id])
  @@map("notifications")
}

model Strike {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  issuedById String?   @map("issued_by_id") @db.Uuid
  reference  String    @unique @db.VarChar(160)
  reason     String    @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  user       User      @relation("StrikeSubject", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issuedBy   User?     @relation("StrikeActor", fields: [issuedById], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt, createdAt, id])
  @@index([issuedById, id])
  @@map("strikes")
}

model AuditLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId          String?  @map("actor_id") @db.Uuid
  action           String   @db.VarChar(80)
  entityType       String   @map("entity_type") @db.VarChar(80)
  entityId         String   @map("entity_id") @db.VarChar(160)
  beforeCiphertext Bytes?   @map("before_ciphertext")
  afterCiphertext  Bytes?   @map("after_ciphertext")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor            User?    @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorId, createdAt, id])
  @@index([entityType, entityId, createdAt, id])
  @@map("audit_log")
}

model ClosingCursor {
  namespace String @id @db.VarChar(160)
  streamId String @default("0-0") @map("stream_id") @db.VarChar(80)
  runtime BidEngineRuntime @relation(fields:[namespace],references:[namespace],onDelete:Restrict,onUpdate:Restrict)
  @@map("closing_cursors")
}

model LotSettlement {
  lotId String @id @map("lot_id") @db.Uuid
  namespace String @db.VarChar(160)
  winnerId String? @map("winner_id") @db.Uuid
  groupId String? @map("group_id") @db.Uuid
  hammerKobo BigInt? @map("hammer_kobo")
  feeVersion String @map("fee_version") @db.VarChar(40)
  streamId String @map("stream_id") @db.VarChar(80)
  barrierId String @map("barrier_id") @db.VarChar(80)
  endAt DateTime @map("end_at") @db.Timestamptz(3)
  closedAt DateTime @map("closed_at") @db.Timestamptz(3)
  snapshot Json
  status String @default("frozen") @db.VarChar(24)
  invoiceId String? @unique @map("invoice_id") @db.Uuid
  relistLotId String? @unique @map("relist_lot_id") @db.Uuid
  paymentDueAt DateTime? @map("payment_due_at") @db.Timestamptz(3)
  lastErrorAt DateTime? @map("last_error_at") @db.Timestamptz(3)
  lot Lot @relation("SettledLot",fields:[lotId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  relistLot Lot? @relation("RelistedLot",fields:[relistLotId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  runtime BidEngineRuntime @relation(fields:[namespace],references:[namespace],onDelete:Restrict,onUpdate:Restrict)
  winner User? @relation(fields:[winnerId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  invoice Invoice? @relation(fields:[invoiceId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@index([namespace,status,paymentDueAt,lotId],map:"lot_settlements_pending_idx")
  @@map("lot_settlements")
}

model IdempotencyKey {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String?   @map("user_id") @db.Uuid
  scope              String    @db.VarChar(80)
  key                String    @db.VarChar(160)
  requestHash        String    @map("request_hash") @db.VarChar(64)
  responseCiphertext Bytes?    @map("response_ciphertext")
  status             String    @default("pending") @db.VarChar(24)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz(3)
  user               User?     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([scope, key])
  @@index([userId, createdAt, id])
  @@index([expiresAt, id])
  @@map("idempotency_keys")
}
