{
  "name": "auction-ng",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.23.4 <23",
    "pnpm": "10.18.3"
  },
  "scripts": {
    "paystack:local": "node scripts/paystack-local.mjs",
    "paystack:check": "node scripts/check-paystack-webhook.mjs",
    "paystack:webhook": "node --import ./apps/api/node_modules/tsx/dist/loader.mjs scripts/paystack-webhook-relay.ts",
    "demo:home": "node --import ./apps/api/node_modules/tsx/dist/loader.mjs scripts/prepare-demo-home.mjs",
    "demo:fixed-prices": "node --import ./apps/api/node_modules/tsx/dist/loader.mjs scripts/prepare-demo-fixed-prices.mjs",
    "staff:setup": "pnpm --filter api staff:setup",
    "dev": "turbo run dev --filter=!mobile",
    "lint": "node scripts/sync-web-font.mjs --check && eslint . && prettier --check .",
    "fonts:generate": "node scripts/sync-web-font.mjs",
    "format": "prettier --write .",
    "tokens:generate": "node scripts/sync-theme.mjs",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "test:redesign": "node scripts/run-redesign-tests.mjs",
    "auth:smoke": "node scripts/check-auth.mjs",
    "email:sync": "node scripts/sync-email-config.mjs",
    "search:configure": "node scripts/configure-search.mjs",
    "bids:configure": "node scripts/configure-bids.mjs",
    "build": "turbo run build",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed": "node scripts/database.mjs seed",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "db:generate": "node scripts/database.mjs generate",
    "db:docs": "node scripts/database.mjs docs",
    "db:keys": "node scripts/database-keys.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.1",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.4",
    "lighthouse": "13.5.0"
  }
}
