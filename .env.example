# Local development only. Copy to .env; never commit .env.
# Change both database settings together if changing local credentials.
POSTGRES_USER=auction_ng
POSTGRES_PASSWORD=auction_ng_local
POSTGRES_DB=auction_ng
# PostgreSQL connection for migrations, seeding, and local integration tests.
DATABASE_URL=postgresql://auction_ng:auction_ng_local@localhost:5432/auction_ng
# Optional separate PostgreSQL connection allowed to CREATE DATABASE for isolated tests.
# TEST_DATABASE_ADMIN_URL=postgresql://auction_ng:auction_ng_local@localhost:5432/postgres
# Generate TWO different 32-byte random values, each encoded as base64.
# Required by demo seed and future encrypted personal-data operations; never commit real values.
DATA_ENCRYPTION_KEY=
PII_HASH_KEY=
# T06: Paystack TEST secret only (sk_test_...). Empty disables provider calls.
# Never use a live key or put credentials into NEXT_PUBLIC_/EXPO_PUBLIC_ variables.
PAYSTACK_SECRET_KEY=
# Shared API/worker secret: at least 32 random characters. Empty disables nightly jobs.
RECONCILIATION_TOKEN=
# Worker-only private API origin. Docker overrides this to http://api:4000.
INTERNAL_API_URL=http://localhost:4000
# T04 local-only email capture. Codes appear at http://localhost:8025, not in real inboxes.
# AUTH_MODE=local explicitly enables development auth; unset it to fail closed.
AUTH_MODE=local
MAILPIT_URL=http://localhost:8025
# Exact browser origins allowed to send credentialed auth requests (no wildcard).
AUTH_WEB_ORIGINS=http://localhost:3300,http://localhost:3301,http://localhost:3310
# Buyer browser endpoints (public URLs only; never credentials).
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4001
# Server-to-server catalogue URL; Docker web uses http://api:4000.
API_INTERNAL_URL=http://localhost:4000
# Local Redis is bound to loopback and is not exposed to the network.
REDIS_URL=redis://localhost:6379
# Allowed browser origins for the realtime gateway; native clients authenticate without Origin.
REALTIME_WEB_ORIGINS=http://localhost:3300,http://localhost:3301,http://localhost:3310
# pnpm test generates BUYER_TEST_DATABASE_URL for isolated buyer fixtures.
# Never point a test fixture at your application database.
# WEB_PERFORMANCE_CHECK=true is used only for the production browser audit.
# Enables bidding, persistence and T12 closing. Enable only after money/bid review.
# Requires AOF yes, fsync always, noeviction.
# Redis restarts pause bids/releases until a reviewed recovery reconciles existing reservations.
BIDS_ENABLED=false
# Unconfirmed reservation lifetime in milliseconds; accepted leading holds never expire here.
BID_PREPARATION_MS=60000
# API/worker-only random credential (at least 32 characters) for cleanup, persistence and closing.
BID_MAINTENANCE_TOKEN=
# Local search URL and development-only master key (at least 16 bytes).
MEILISEARCH_URL=http://localhost:7700
MEILI_MASTER_KEY=auction-ng-local-search-key
# Bound local/VPS indexing resources so search does not monopolise the host.
MEILI_MAX_INDEXING_THREADS=2
MEILI_MAX_INDEXING_MEMORY=256MiB
# T08: private index name; use an isolated name for automated acceptance tests.
MEILISEARCH_INDEX=auction_ng_open_lots_v1
# API/worker-only random credential, minimum 32 characters. Generate with pnpm search:configure.
SEARCH_SYNC_TOKEN=
# HTTP process ports. Web and admin use 3000 and 3001.
API_PORT=4000
REALTIME_PORT=4001
# Docker host ports. Containers keep the standard internal ports.
# 3300/3301 avoid a local VPN service occupying port 3000.
WEB_HOST_PORT=3300
ADMIN_HOST_PORT=3301
API_HOST_PORT=4000
REALTIME_HOST_PORT=4001
# T07: optional R2 uploads. Empty account ID disables upload endpoints.
# Scope the credential to these two buckets; keep incoming originals PRIVATE.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOAD_BUCKET=
R2_PUBLIC_BUCKET=
# HTTPS origin of the public derivatives bucket custom domain, without a path.
R2_PUBLIC_URL=
