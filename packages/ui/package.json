{
  "name": "@auction-ng/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./tokens.ts",
    "./tokens": "./tokens.ts",
    "./theme.css": "./theme.css",
    "./fonts.css": "./fonts/web.css",
    "./fonts-external.css": "./fonts/external.css",
    "./web": "./web/index.ts",
    "./styles.css": "./web/styles.css",
    "./presentation": "./presentation.ts",
    "./web/*": "./web/*.tsx"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "react": "19.2.0",
    "@types/react": "19.2.18"
  },
  "dependencies": {
    "@auction-ng/shared": "workspace:*",
    "lucide-react": "1.61.0"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  }
}
