{
  "name": "@auction-ng/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bid-persistence": "./src/bid-persistence.ts",
    "./realtime-api": "./src/realtime-api.ts",
    "./realtime": "./src/realtime.ts",
    "./realtime-hook": "./src/realtime-hook.ts"
  },
  "typesVersions": {
    "*": {
      "bid-persistence": [
        "src/bid-persistence.ts"
      ],
      "realtime-api": [
        "src/realtime-api.ts"
      ],
      "realtime": [
        "src/realtime.ts"
      ],
      "realtime-hook": [
        "src/realtime-hook.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@auction-ng/shared": "workspace:*",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
